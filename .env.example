# PixGen 环境变量示例模板
# 复制为 `.env.local` 后填入实际值；严禁将含真实凭据的 `.env` / `.env.local` 提交到 Git。
# 变量定义来源：lib/env.ts、lib/billing/env.ts、lib/agent/env.ts

# ============================================================
# 1. 站点与 Supabase（来源：lib/env.ts）
# ============================================================
# 站点基地址（用于 OAuth 回调与支付结果回跳）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase 项目 URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase 匿名公钥
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase 服务端密钥（仅服务端使用，严禁暴露给浏览器）
SUPABASE_SERVICE_ROLE_KEY=
# 管理员邮箱列表（可选，逗号分隔，用于 /admin 后台权限）
ADMIN_EMAILS=

# ============================================================
# 2. 图像生成与 Mock 生产守卫（来源：lib/env.ts）
# ============================================================
# OpenAI 或 OpenAI 兼容中继 API 密钥
OPENAI_API_KEY=
# 可选：OpenAI 兼容中继地址，例如 https://your-relay.example.com/v1
OPENAI_BASE_URL=
# 图像生成模型名（默认 gpt-image2）
OPENAI_IMAGE_MODEL=gpt-image2
# 图像提供方：openai | mock（本地无外部 API 联调可设为 mock）
IMAGE_PROVIDER=mock
# 生产环境是否允许使用 mock 提供方（默认 false；同时作用于图像/计费/Agent）
ALLOW_MOCK_IN_PRODUCTION=false

# ============================================================
# 3. 计费与聚合支付（来源：lib/billing/env.ts）
# ============================================================
# 支付提供方：mock | lantu | xunhupay（默认 mock）
BILLING_PROVIDER=mock
# 订单有效期（分钟，1-120，默认 15）
ORDER_TTL_MINUTES=15
# 本地 mock 支付签名密钥（默认 mock-secret）
MOCK_APP_SECRET=mock-secret

# 蓝兔支付（BILLING_PROVIDER=lantu 时必填）
LANTU_MCH_ID=
LANTU_APP_SECRET=
LANTU_API_BASE=https://api.ltzf.cn

# 虎皮椒支付（BILLING_PROVIDER=xunhupay 时必填）
XUNHUPAY_APP_ID=
XUNHUPAY_APP_SECRET=
XUNHUPAY_API_BASE=https://api.xunhupay.com

# ============================================================
# 4. Agent 工作台对话模型（来源：lib/agent/env.ts）
# ============================================================
# Agent 大脑提供方：mock | real（默认 mock）
AGENT_PROVIDER=mock
# OpenAI 兼容对话模型基地址（默认智谱接口）
AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Agent 对话模型 API 密钥（AGENT_PROVIDER=real 时必填）
AGENT_LLM_API_KEY=
# Agent 对话模型名（默认 glm-4.6）
AGENT_LLM_MODEL=glm-4.6
# 单次 Agent 循环最大工具迭代轮次（1-10，默认 5）
AGENT_MAX_ITERATIONS=5

# ============================================================
# 5. Stripe 国际收款预留（待子项目 B 接入）
# ============================================================
# Stripe 服务端密钥（待子项目 B 接入）
STRIPE_SECRET_KEY=
# Stripe Webhook 签名密钥（待子项目 B 接入）
STRIPE_WEBHOOK_SECRET=
# Stripe 前端公钥（待子项目 B 接入）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
